name: Multi-Runner Discovery (Template)

# This is a TEMPLATE - uncomment and customize after checking your runner labels!
# Go to: https://github.com/intel/gvk/settings/actions/runners
# See what labels your runners have, then update the matrix below

on:
  workflow_dispatch:  # Manual trigger only
  # push:
  #   branches:
  #     - setup-github-actions
  #   paths:
  #     - '.github/workflows/multi-runner-discovery.yml'

jobs:
  discover-all-runners:
    name: Discover Runner ${{ matrix.runner-label }}

    # CUSTOMIZE THIS: Replace with your actual runner labels
    strategy:
      matrix:
        runner-label: 
          - runner-1  # ? Replace with actual label from runner 1
          - runner-2  # ? Replace with actual label from runner 2
      fail-fast: false  # Continue even if one fails

    runs-on: [self-hosted, linux, ${{ matrix.runner-label }}]
    timeout-minutes: 5

    steps:
    - name: Report This Runner
      run: |
        echo "========================================="
        echo "RUNNER DETECTED: ${{ matrix.runner-label }}"
        echo "========================================="
        echo ""
        echo "Runner Name: $RUNNER_NAME"
        echo "Runner OS: $RUNNER_OS"
        echo "Runner Arch: $RUNNER_ARCH"
        echo "Matrix Label: ${{ matrix.runner-label }}"
        echo ""
        echo "Hostname: $(hostname)"
        echo "OS: $(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2 || echo "Unknown")"
        echo "Kernel: $(uname -r)"
        echo ""
        echo "Docker: $(docker --version 2>&1 || echo "Not installed")"
        echo "CMake: $(cmake --version 2>&1 | head -n1 || echo "Not installed")"
        echo "GCC: $(gcc --version 2>&1 | head -n1 || echo "Not installed")"
        echo "Clang: $(clang --version 2>&1 | head -n1 || echo "Not installed")"
        echo ""

    - name: Generate Detailed Report
      run: |
        REPORT_FILE="runner-${{ matrix.runner-label }}-report.md"

        cat > "$REPORT_FILE" << 'EOFREPORT'
        # Runner: ${{ matrix.runner-label }}

        Generated: $(date +"%Y-%m-%d %H:%M:%S")

        ## Runner Information

        ```
        Runner Name: $RUNNER_NAME
        Runner OS: $RUNNER_OS
        Runner Arch: $RUNNER_ARCH
        Matrix Label: ${{ matrix.runner-label }}
        Hostname: $(hostname)
        ```

        ## System Information

        ```
        OS: $(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2)
        Kernel: $(uname -r)
        Architecture: $(uname -m)
        CPU: $(lscpu | grep "Model name" | cut -d: -f2 | xargs)
        Cores: $(nproc)
        Memory: $(free -h | grep Mem | awk '{print $2}')
        ```

        ## GPU

        ```
        $(lspci | grep -i "vga\|3d\|display" || echo "No GPU detected")
        ```

        ## Build Tools

        ```
        Docker: $(docker --version 2>&1 || echo "Not installed")
        CMake: $(cmake --version 2>&1 | head -n1 || echo "Not installed")
        Ninja: $(ninja --version 2>&1 || echo "Not installed")
        GCC: $(gcc --version 2>&1 | head -n1 || echo "Not installed")
        G++: $(g++ --version 2>&1 | head -n1 || echo "Not installed")
        Clang: $(clang --version 2>&1 | head -n1 || echo "Not installed")
        Clang++: $(clang++ --version 2>&1 | head -n1 || echo "Not installed")
        Python3: $(python3 --version 2>&1 || echo "Not installed")
        Git: $(git --version 2>&1 || echo "Not installed")
        ```

        ## Docker Status

        ```
        $(if command -v docker &> /dev/null; then
            if docker info &> /dev/null 2>&1; then
                echo "Docker: INSTALLED and RUNNING"
                docker info 2>&1 | head -n 10
            else
                echo "Docker: INSTALLED but NOT RUNNING"
            fi
        else
            echo "Docker: NOT INSTALLED"
        fi)
        ```

        EOFREPORT

        cat "$REPORT_FILE"

    - name: Upload Runner Report
      uses: actions/upload-artifact@v4
      with:
        name: runner-${{ matrix.runner-label }}-report
        path: runner-${{ matrix.runner-label }}-report.md
        retention-days: 30

  combine-all-reports:
    name: Combine All Runner Reports
    needs: [discover-all-runners]
    runs-on: [self-hosted, linux]
    if: always()
    timeout-minutes: 5

    steps:
    - name: Download All Reports
      uses: actions/download-artifact@v4
      with:
        pattern: runner-*-report
        path: all-runners/
        merge-multiple: true

    - name: Combine Reports
      run: |
        COMBINED="all-runners-combined-report.md"

        echo "# All Runners Report" > "$COMBINED"
        echo "" >> "$COMBINED"
        echo "Generated: $(date +"%Y-%m-%d %H:%M:%S")" >> "$COMBINED"
        echo "" >> "$COMBINED"

        # Count runners
        RUNNER_COUNT=$(ls all-runners/runner-*-report.md 2>/dev/null | wc -l)
        echo "**Total Runners Detected:** $RUNNER_COUNT" >> "$COMBINED"
        echo "" >> "$COMBINED"
        echo "---" >> "$COMBINED"
        echo "" >> "$COMBINED"

        # Combine all reports
        for report in all-runners/runner-*-report.md; do
          if [ -f "$report" ]; then
            cat "$report" >> "$COMBINED"
            echo "" >> "$COMBINED"
            echo "---" >> "$COMBINED"
            echo "" >> "$COMBINED"
          fi
        done

        echo "Combined report created!"
        cat "$COMBINED"

    - name: Upload Combined Report
      uses: actions/upload-artifact@v4
      with:
        name: all-runners-combined-report
        path: all-runners-combined-report.md
        retention-days: 30
