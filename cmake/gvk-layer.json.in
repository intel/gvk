
{
    "file_format_version" : "1.1.1",
    "layer" : {
        "name": "@ARGS_TARGET@",
        "type": "GLOBAL",
        "library_path": "@libraryPath@",
        "api_version": "@Vulkan_VERSION@",
        "implementation_version": "@ARGS_VERSION@",
        "description": "@ARGS_DESCRIPTION@",
        "disable_environment": { "DISABLE_@ARGS_TARGET@": "1" },
        "enable_environment": { "ENABLE_@ARGS_TARGET@": "1" }
    }
}
